function [alpha_hat, c_hat, theta_hat, theta_dot_hat] = lyapunov_estimator( ...
    t, theta, theta_dot, u, gamma_alpha, gamma_c, alpha0, c0)
%   Implements the Lyapunov-based method for online estimation of alpha = g/l and c.
%
%   System equation:  theta_ddot(t) = -alpha*sin(theta(t)) - c*theta_dot(t) + u(t)
%
%   Inputs:
%     t           - time vector               [N x 1]
%     theta       - measured pendulum angle   [N x 1]
%     theta_dot   - measured angular velocity [N x 1]
%     u_vec       - control input             [N x 1]
%     gamma_alpha - adaptation gain for alpha = g/l
%     gamma_c     - adaptation gain for c
%     alpha0      - initial estimate for alpha
%     c0          - initial estimate for c
%
%   Outputs:
%     alpha_hat     - time history of alpha = g/l estimates        [N x 1]
%     c_hat         - time history of c estimates                  [N x 1]
%     theta_hat     - estimated angle trajectory (series-parallel) [N x 1]
%     theta_dot_hat - estimated angular velocity                   [N x 1]
%
%   Series-Parallel Estimation Model:
%     theta_dot_hat_dot = -alpha_hat * sin(theta) - c_hat * theta_dot + u
%
%   Velocity Tracking Error:
%     s = theta_dot - theta_dot_hat
%
%   Lyapunov Update Laws (Euler integration):
%     d(alpha_hat)/dt = gamma_alpha * s * sin(theta)
%     d(c_hat)/dt = gamma_c * s * theta_dot

N = length(t);
alpha_hat = zeros(N, 1);
c_hat = zeros(N, 1);
theta_dot_hat = zeros(N, 1);
theta_hat = zeros(N, 1);

% Initialise (align parallel model with true initial conditions)
alpha_hat(1) = alpha0;
c_hat(1) = c0;
theta_dot_hat(1) = theta_dot(1);
theta_hat(1) = theta(1);

for i = 1 : N - 1
    dt_i = t(i+1) - t(i);

    % Velocity tracking error (the Lyapunov driving signal)
    s = theta_dot(i) - theta_dot_hat(i);

    % Series-parallel model: theta_dot_hat dynamics
    % Uses measured true states theta, theta_dot (not estimated ones)
    theta_dot_hat_dot = -alpha_hat(i) * sin(theta(i)) ...
                        - c_hat(i) * theta_dot(i) + u(i);

    % Euler integration: advance parallel model states
    theta_dot_hat(i+1) = theta_dot_hat(i) + dt_i * theta_dot_hat_dot;
    theta_hat(i+1) = theta_hat(i) + dt_i * theta_dot_hat(i);

    % Lyapunov-based update laws (V_dot = 0)
    alpha_hat(i+1) = alpha_hat(i) + dt_i * gamma_alpha * s * sin(theta(i));
    c_hat(i+1) = c_hat(i) + dt_i * gamma_c * s * theta_dot(i);

    % Parameter projection: enforce physical positivity constraints7

    alpha_hat(i+1) = max(alpha_hat(i+1), 0.5);
    c_hat(i+1) = max(c_hat(i+1), 0.01);
end

end
